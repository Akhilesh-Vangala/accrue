<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1515;CA1848;CA1716;CA1062;CA2007;CA1819;CA1711;CA1720;CA1724;CA1308;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304</NoWarn>
  </PropertyGroup>

  <!--
    Telerik Reporting ships from Telerik's private NuGet feed (https://nuget.telerik.com/v3/index.json).
    Build with -p:UseTelerik=true once the feed credentials are configured (see README, "Reporting").
    TelerikPackageSuffix is ".Trial" for the 30-day trial and empty for a licensed install.
  -->
  <PropertyGroup>
    <UseTelerik Condition="'$(UseTelerik)' == ''">false</UseTelerik>
    <TelerikPackageSuffix Condition="'$(TelerikPackageSuffix)' == ''">.Trial</TelerikPackageSuffix>
    <DefineConstants Condition="'$(UseTelerik)' == 'true'">$(DefineConstants);TELERIK</DefineConstants>
  </PropertyGroup>
</Project>
