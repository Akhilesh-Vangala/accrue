<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="spendData" Width="7.5in" Name="VendorSpend" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource ConnectionString="Accrue" ProviderName="Microsoft.Data.SqlClient" Name="spendData"
      SelectCommand="SELECT VendorName, Category, PeriodStart, InvoiceCount, TotalAmount FROM dbo.vw_VendorSpend WHERE PeriodStart &gt;= DATEFROMPARTS(YEAR(@from), MONTH(@from), 1) AND PeriodStart &lt;= @to ORDER BY Category, VendorName, PeriodStart">
      <Parameters>
        <SqlDataSourceParameter DbType="Date" Name="@from">
          <Value>
            <String>= Parameters.from.Value</String>
          </Value>
        </SqlDataSourceParameter>
        <SqlDataSourceParameter DbType="Date" Name="@to">
          <Value>
            <String>= Parameters.to.Value</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
  </DataSources>
  <Items>
    <PageHeaderSection Height="0.9in" Name="pageHeader">
      <Items>
        <TextBox Value="Accrue" Left="0in" Top="0in" Width="3in" Height="0.3in" Name="brand">
          <Style Color="0, 128, 96"><Font Size="11pt" Bold="True" /></Style>
        </TextBox>
        <TextBox Value="Vendor spend" Left="0in" Top="0.3in" Width="4in" Height="0.4in" Name="title">
          <Style><Font Size="18pt" Bold="True" /></Style>
        </TextBox>
        <TextBox Value="= Format('{0:MMM d, yyyy}', Parameters.from.Value) + ' to ' + Format('{0:MMM d, yyyy}', Parameters.to.Value)" Left="4in" Top="0.35in" Width="3.5in" Height="0.3in" Name="range">
          <Style TextAlign="Right" Color="Gray" />
        </TextBox>
      </Items>
    </PageHeaderSection>
    <ReportHeaderSection Height="0.6in" Name="summary">
      <Items>
        <TextBox Value="= 'Total spend: ' + Format('{0:C2}', Sum(Fields.TotalAmount)) + ' across ' + Sum(Fields.InvoiceCount) + ' invoices'" Left="0in" Top="0.1in" Width="7.5in" Height="0.35in" Name="total">
          <Style><Font Size="12pt" Bold="True" /></Style>
        </TextBox>
      </Items>
    </ReportHeaderSection>
    <DetailSection Height="0.25in" Name="detail">
      <Items>
        <TextBox Value="= Fields.VendorName" Left="0.2in" Top="0in" Width="3.3in" Height="0.25in" Name="vendor" />
        <TextBox Value="= Fields.PeriodStart" Format="{0:MMM yyyy}" Left="3.5in" Top="0in" Width="1.5in" Height="0.25in" Name="period" />
        <TextBox Value="= Fields.InvoiceCount" Left="5in" Top="0in" Width="1in" Height="0.25in" Name="count">
          <Style TextAlign="Right" />
        </TextBox>
        <TextBox Value="= Fields.TotalAmount" Format="{0:C2}" Left="6in" Top="0in" Width="1.5in" Height="0.25in" Name="amount">
          <Style TextAlign="Right" />
        </TextBox>
      </Items>
    </DetailSection>
    <PageFooterSection Height="0.35in" Name="pageFooter">
      <Items>
        <TextBox Value="= 'Page ' + PageNumber + ' of ' + PageCount" Left="5in" Top="0.05in" Width="2.5in" Height="0.25in" Name="pageNumber">
          <Style TextAlign="Right" Color="Gray"><Font Size="8pt" /></Style>
        </TextBox>
      </Items>
    </PageFooterSection>
  </Items>
  <Groups>
    <Group Name="categoryGroup">
      <GroupHeader>
        <GroupHeaderSection Height="0.55in" Name="categoryHeader">
          <Items>
            <TextBox Value="= Fields.Category" Left="0in" Top="0.05in" Width="4in" Height="0.25in" Name="categoryTitle">
              <Style Color="0, 128, 96"><Font Size="11pt" Bold="True" /></Style>
            </TextBox>
            <TextBox Value="Vendor" Left="0.2in" Top="0.3in" Width="3.3in" Height="0.22in" Name="hVendor">
              <Style Color="Gray"><Font Size="8pt" Bold="True" /></Style>
            </TextBox>
            <TextBox Value="Month" Left="3.5in" Top="0.3in" Width="1.5in" Height="0.22in" Name="hMonth">
              <Style Color="Gray"><Font Size="8pt" Bold="True" /></Style>
            </TextBox>
            <TextBox Value="Invoices" Left="5in" Top="0.3in" Width="1in" Height="0.22in" Name="hCount">
              <Style TextAlign="Right" Color="Gray"><Font Size="8pt" Bold="True" /></Style>
            </TextBox>
            <TextBox Value="Amount" Left="6in" Top="0.3in" Width="1.5in" Height="0.22in" Name="hAmount">
              <Style TextAlign="Right" Color="Gray"><Font Size="8pt" Bold="True" /></Style>
            </TextBox>
          </Items>
        </GroupHeaderSection>
      </GroupHeader>
      <GroupFooter>
        <GroupFooterSection Height="0.35in" Name="categoryFooter">
          <Items>
            <TextBox Value="= Fields.Category + ' total'" Left="3.5in" Top="0.05in" Width="2.5in" Height="0.25in" Name="subtotalLabel">
              <Style TextAlign="Right"><Font Bold="True" /></Style>
            </TextBox>
            <TextBox Value="= Sum(Fields.TotalAmount)" Format="{0:C2}" Left="6in" Top="0.05in" Width="1.5in" Height="0.25in" Name="subtotal">
              <Style TextAlign="Right"><Font Bold="True" /></Style>
            </TextBox>
          </Items>
        </GroupFooterSection>
      </GroupFooter>
      <Groupings>
        <Grouping Expression="= Fields.Category" />
      </Groupings>
      <Sortings>
        <Sorting Expression="= Fields.Category" Direction="Asc" />
      </Sortings>
    </Group>
  </Groups>
  <ReportParameters>
    <ReportParameter Name="from" Type="DateTime" Text="From" Visible="True">
      <Value>
        <String>= Today().AddMonths(-6)</String>
      </Value>
    </ReportParameter>
    <ReportParameter Name="to" Type="DateTime" Text="To" Visible="True">
      <Value>
        <String>= Today()</String>
      </Value>
    </ReportParameter>
  </ReportParameters>
  <PageSettings PaperKind="Letter" Landscape="False">
    <Margins>
      <MarginsU Left="0.5in" Right="0.5in" Top="0.5in" Bottom="0.5in" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
      <Style>
        <Font Name="Segoe UI" Size="9pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
</Report>
