{
  "ConnectionStrings": {
    "LedgerFlow": ""
  },
  "Database": {
    "MigrateOnStartup": true,
    "Seed": false
  },
  "Hangfire": {
    "ServerEnabled": true
  },
  "OpenApi": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*"
}
