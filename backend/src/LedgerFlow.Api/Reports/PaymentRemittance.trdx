<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="remittanceData" Width="7.5in" Name="PaymentRemittance" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource ConnectionString="LedgerFlow" ProviderName="Microsoft.Data.SqlClient" Name="remittanceData"
      SelectCommand="SELECT RunName, PaymentDate, RunStatus, VendorName, VendorEmail, InvoiceNumber, InvoiceDate, Amount, Reference FROM dbo.vw_PaymentRemittance WHERE PaymentRunId = @paymentRunId ORDER BY VendorName, InvoiceNumber">
      <Parameters>
        <SqlDataSourceParameter DbType="Int32" Name="@paymentRunId">
          <Value>
            <String>= Parameters.paymentRunId.Value</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
    <SqlDataSource ConnectionString="LedgerFlow" ProviderName="Microsoft.Data.SqlClient" Name="runLookup"
      SelectCommand="SELECT Id, Name + ' (' + CONVERT(varchar(10), PaymentDate, 23) + ')' AS Label FROM dbo.PaymentRuns WHERE Status = N'Released' ORDER BY PaymentDate DESC" />
  </DataSources>
  <Items>
    <PageHeaderSection Height="0.9in" Name="pageHeader">
      <Items>
        <TextBox Value="LedgerFlow" Left="0in" Top="0in" Width="3in" Height="0.3in" Name="brand">
          <Style Color="0, 128, 96"><Font Size="11pt" Bold="True" /></Style>
        </TextBox>
        <TextBox Value="Remittance advice" Left="0in" Top="0.3in" Width="4in" Height="0.4in" Name="title">
          <Style><Font Size="18pt" Bold="True" /></Style>
        </TextBox>
        <TextBox Value="= First(Fields.RunName) + ' | paid ' + Format('{0:MMM d, yyyy}', First(Fields.PaymentDate))" Left="3.5in" Top="0.35in" Width="4in" Height="0.3in" Name="run">
          <Style TextAlign="Right" Color="Gray" />
        </TextBox>
      </Items>
    </PageHeaderSection>
    <DetailSection Height="0.25in" Name="detail">
      <Items>
        <TextBox Value="= Fields.InvoiceNumber" Left="0.2in" Top="0in" Width="2in" Height="0.25in" Name="invoice" />
        <TextBox Value="= Fields.InvoiceDate" Format="{0:yyyy-MM-dd}" Left="2.2in" Top="0in" Width="1.3in" Height="0.25in" Name="invoiceDate" />
        <TextBox Value="= Fields.Reference" Left="3.5in" Top="0in" Width="2.5in" Height="0.25in" Name="reference" />
        <TextBox Value="= Fields.Amount" Format="{0:C2}" Left="6in" Top="0in" Width="1.5in" Height="0.25in" Name="amount">
          <Style TextAlign="Right" />
        </TextBox>
      </Items>
    </DetailSection>
    <ReportFooterSection Height="0.5in" Name="reportFooter">
      <Items>
        <TextBox Value="= 'Run total (' + Count(Fields.InvoiceNumber) + ' payments)'" Left="2.2in" Top="0.1in" Width="3.8in" Height="0.3in" Name="totalLabel">
          <Style TextAlign="Right"><Font Size="11pt" Bold="True" /></Style>
        </TextBox>
        <TextBox Value="= Sum(Fields.Amount)" Format="{0:C2}" Left="6in" Top="0.1in" Width="1.5in" Height="0.3in" Name="total">
          <Style TextAlign="Right"><Font Size="11pt" Bold="True" /></Style>
        </TextBox>
      </Items>
    </ReportFooterSection>
    <PageFooterSection Height="0.35in" Name="pageFooter">
      <Items>
        <TextBox Value="Questions about this payment? Reply to ap@ledgerflow.dev and quote the reference." Left="0in" Top="0.05in" Width="5in" Height="0.25in" Name="contact">
          <Style Color="Gray"><Font Size="8pt" /></Style>
        </TextBox>
        <TextBox Value="= 'Page ' + PageNumber + ' of ' + PageCount" Left="5in" Top="0.05in" Width="2.5in" Height="0.25in" Name="pageNumber">
          <Style TextAlign="Right" Color="Gray"><Font Size="8pt" /></Style>
        </TextBox>
      </Items>
    </PageFooterSection>
  </Items>
  <Groups>
    <Group Name="vendorGroup">
      <GroupHeader>
        <GroupHeaderSection Height="0.6in" Name="vendorHeader">
          <Items>
            <TextBox Value="= Fields.VendorName" Left="0in" Top="0.05in" Width="4in" Height="0.25in" Name="vendorName">
              <Style Color="0, 128, 96"><Font Size="11pt" Bold="True" /></Style>
            </TextBox>
            <TextBox Value="= Fields.VendorEmail" Left="4in" Top="0.05in" Width="3.5in" Height="0.25in" Name="vendorEmail">
              <Style TextAlign="Right" Color="Gray" />
            </TextBox>
            <TextBox Value="Invoice" Left="0.2in" Top="0.35in" Width="2in" Height="0.22in" Name="hInvoice">
              <Style Color="Gray"><Font Size="8pt" Bold="True" /></Style>
            </TextBox>
            <TextBox Value="Invoice date" Left="2.2in" Top="0.35in" Width="1.3in" Height="0.22in" Name="hInvoiceDate">
              <Style Color="Gray"><Font Size="8pt" Bold="True" /></Style>
            </TextBox>
            <TextBox Value="Payment reference" Left="3.5in" Top="0.35in" Width="2.5in" Height="0.22in" Name="hReference">
              <Style Color="Gray"><Font Size="8pt" Bold="True" /></Style>
            </TextBox>
            <TextBox Value="Amount" Left="6in" Top="0.35in" Width="1.5in" Height="0.22in" Name="hAmount">
              <Style TextAlign="Right" Color="Gray"><Font Size="8pt" Bold="True" /></Style>
            </TextBox>
          </Items>
        </GroupHeaderSection>
      </GroupHeader>
      <GroupFooter>
        <GroupFooterSection Height="0.35in" Name="vendorFooter">
          <Items>
            <TextBox Value="= Fields.VendorName + ' total'" Left="2.2in" Top="0.05in" Width="3.8in" Height="0.25in" Name="vendorTotalLabel">
              <Style TextAlign="Right"><Font Bold="True" /></Style>
            </TextBox>
            <TextBox Value="= Sum(Fields.Amount)" Format="{0:C2}" Left="6in" Top="0.05in" Width="1.5in" Height="0.25in" Name="vendorTotal">
              <Style TextAlign="Right"><Font Bold="True" /></Style>
            </TextBox>
          </Items>
        </GroupFooterSection>
      </GroupFooter>
      <Groupings>
        <Grouping Expression="= Fields.VendorName" />
      </Groupings>
      <Sortings>
        <Sorting Expression="= Fields.VendorName" Direction="Asc" />
      </Sortings>
    </Group>
  </Groups>
  <ReportParameters>
    <ReportParameter Name="paymentRunId" Type="Integer" Text="Payment run" Visible="True">
      <AvailableValues DataSourceName="runLookup" DisplayMember="= Fields.Label" ValueMember="= Fields.Id" />
    </ReportParameter>
  </ReportParameters>
  <PageSettings PaperKind="Letter" Landscape="False">
    <Margins>
      <MarginsU Left="0.5in" Right="0.5in" Top="0.5in" Bottom="0.5in" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
      <Style>
        <Font Name="Segoe UI" Size="9pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
</Report>
