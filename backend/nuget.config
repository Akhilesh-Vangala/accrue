<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="telerik" value="https://nuget.telerik.com/v3/index.json" />
  </packageSources>

  <!-- Vulnerability data comes from nuget.org only; otherwise the audit would query the authenticated Telerik feed on every restore. -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>

  <!--
    Source mapping keeps Telerik.* on the Telerik feed and everything else on nuget.org,
    so builds without -p:UseTelerik=true never contact the private feed.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="telerik">
      <package pattern="Telerik.*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Credentials come from the environment; never commit them. Username "api-key" + a Telerik NuGet API key works for CI. -->
  <packageSourceCredentials>
    <telerik>
      <add key="Username" value="%TELERIK_NUGET_USER%" />
      <add key="ClearTextPassword" value="%TELERIK_NUGET_KEY%" />
    </telerik>
  </packageSourceCredentials>
</configuration>
